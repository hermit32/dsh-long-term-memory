{
  "name": "dsh-memory-feiyu",
  "version": "2.0.2",
  "type": "module",
  "description": "Long-term memory plugin for DeepSeek Harness: atomic short-term memories, AI-curated long-term profile, floating core memory, cold archive, and incremental context injection.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "context-injection",
    "llm-agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "repair-summary-index": "node scripts/repair-summary-index.mjs",
    "privacy:scan": "node tests/privacy-scan.mjs .",
    "package:check": "node tests/check-package.mjs",
    "demo:check": "node tests/check-demo-data.mjs",
    "link:dsh-deps": "node scripts/link-runtime-deps.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermit32/dsh-long-term-memory.git"
  },
  "homepage": "https://github.com/hermit32/dsh-long-term-memory#readme",
  "bugs": {
    "url": "https://github.com/hermit32/dsh-long-term-memory/issues"
  }
}
