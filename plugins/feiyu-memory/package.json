{
  "name": "dsh-memory-feiyu",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "DSH 两层 AI 记忆插件：短期事实、AI Curator 长期认知、工作区隔离、跨会话/长会话持续同步。",
  "license": "UNLICENSED",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "repair-summary-index": "node scripts/repair-summary-index.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
